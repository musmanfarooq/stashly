rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function ownerUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    function canDeleteHoldings() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canDeleteHoldings == true;
    }

    // USERS — each user reads/writes only their own doc.
    // isAdmin can never be set or changed by the client; only via the
    // Firebase console (2.1), which uses the Admin SDK and bypasses these rules.
    // A new user doc must start with delete access enabled by default.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.isAdmin == false
                    && request.resource.data.canDeleteHoldings == true;
      allow update: if isOwner(userId)
                    && request.resource.data.isAdmin == resource.data.isAdmin;
      allow delete: if false;
    }

    // TRANSACTIONS — source of truth for buys/sells (2.2).
    // A locked (sold) record can never be updated again, by anyone, for any reason.
    // Deletion is opt-in per user (canDeleteHoldings) and only ever allowed for
    // a buy lot that's never had any shares sold against it — a sell record, a
    // locked lot, or a partially-sold lot can never be deleted, by anyone.
    match /transactions/{transactionId} {
      allow read:   if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && resource.data.locked != true
                    && ownerUnchanged();
      allow delete: if isOwner(resource.data.userId)
                    && canDeleteHoldings()
                    && resource.data.action == "buy"
                    && resource.data.locked != true
                    && resource.data.remainingShares == resource.data.shares;
    }

    // HOLDINGS — denormalized per-symbol summary, fully owned by the user (3.2).
    match /holdings/{holdingId} {
      allow read:   if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.userId);
    }

    // TYPES — category dropdown values. Global and shared across every user;
    // only an admin can add, edit, or remove one. Migrated from the old
    // per-user model where each user had their own private copy.
    match /types/{typeId} {
      allow read:   if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // DIVIDENDS — permanently immutable once created (2.11).
    match /dividends/{dividendId} {
      allow read:   if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if false;
      allow delete: if false;
    }

    // CRYPTO SYMBOL MAP — cached ticker -> CoinGecko coin-id lookups, global
    // and shared. Not sensitive/editable data — it's a deterministic mapping
    // derived from a public API, cached so it's resolved once per symbol
    // rather than once per user per session. Any signed-in user can write,
    // since a client can only ever write the same correct mapping a search
    // against the public API would return anyway.
    match /cryptoSymbolMap/{symbol} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
